{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "Base Exam Settings Success Response Schema",
  "properties": {
    "visibility": {
      "type": "boolean"
    },
    "handheldSettings": {
      "type": "object",
      "required": [
        "allowPhone",
        "allowTablet",
        "phoneExamPage",
        "tabletExamPage"
      ],
      "properties": {
        "allowPhone": {
          "type": "boolean"
        },
        "allowTablet": {
          "type": "boolean"
        },
        "phoneExamPage": {
          "type": "string",
          "enum": [
            "REGULAR",
            "MOBILE"
          ]
        },
        "tabletExamPage": {
          "type": "string",
          "enum": [
            "REGULAR",
            "MOBILE"
          ]
        }
      }
    },
    "showAnswersAfterExam": {
      "type": "boolean",
      "description": "If this should be like a training exam and show them the answers after the exam."
    },
    "showResultsAfterExam": {
      "type": "boolean",
      "description": "If they should see their scores after the exam."
    },
    "requirePreverification": {
      "type": "boolean"
    },
    "examiner": {
      "type": [
        "object",
        "null"
      ],
      "description": "A one-entry map from the examiner name to the examiner email address.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "internetDisconnectionPolicy": {
      "type": "object",
      "required": [
        "onDisconnect",
        "after"
      ],
      "properties": {
        "onDisconnect": {
          "type": "string",
          "enum": [
            "DO_NOTHING",
            "PAUSE_EXAM",
            "LOGOUT_EXAMINEE"
          ]
        },
        "after": {
          "type": "integer",
          "description": "The number of failed attempts to save state before taking the onDisconnect action. Minimum value is 1."
        }
      }
    },
    "inExamLiveProcturing": {
      "type": "boolean"
    },
    "proctorPolicy": {
      "type": "object",
      "required": [
        "onDisconnect",
        "after"
      ],
      "properties": {
        "onDisconnect": {
          "type": "string",
          "enum": [
            "DO_NOTHING",
            "PAUSE_EXAM",
            "LOGOUT_EXAMINEE"
          ]
        },
        "after": {
          "type": "integer",
          "description": "The number of seconds to wait before taking the onDisconnect action"
        }
      }
    }
  },
  "required": [
    "visibility",
    "handheldSettings",
    "showAnswersAfterExam",
    "showResultsAfterExam",
    "requirePreverification",
    "examiner",
    "internetDisconnectionPolicy",
    "inExamLiveProcturing",
    "proctorPolicy"
  ]
}
