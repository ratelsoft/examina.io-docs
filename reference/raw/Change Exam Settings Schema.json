{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "visibility": {
      "type": "boolean"
    },
    "allowPhone": {
      "type": "boolean"
    },
    "allowTablet": {
      "type": "boolean"
    },
    "phoneExamPage": {
      "type": "string",
      "enum": [
        "REGULAR",
        "MOBILE"
      ]
    },
    "tabletExamPage": {
      "type": "string",
      "enum": [
        "REGULAR",
        "MOBILE"
      ]
    },
    "showAnswersAfterExam": {
      "type": "boolean"
    },
    "showResultsAfterExam": {
      "type": "boolean"
    },
    "requirePreverification": {
      "type": "boolean"
    },
    "examinerName": {
      "type": "string"
    },
    "examinerEmail": {
      "type": "string"
    },
    "internetPolicyDisconnect": {
      "type": "string",
      "enum": [
        "DO_NOTHING",
        "PAUSE_EXAM",
        "LOGOUT_EXAMINEE"
      ]
    },
    "internetPolicyAttempts": {
      "type": "integer"
    },
    "inExamLiveProcturing": {
      "type": "boolean"
    },
    "proctorPolicyDisconnect": {
      "type": "string",
      "enum": [
        "DO_NOTHING",
        "PAUSE_EXAM",
        "LOGOUT_EXAMINEE"
      ]
    },
    "proctorPolicySeconds": {
      "type": "integer"
    }
  }
}
