{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "Exam schema",
  "properties": {
    "id": {
      "type": "string"
    },
    "examCode": {
      "type": "string"
    },
    "examTitle": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "brandingImage": {
      "type": [
        "null",
        "string"
      ]
    },
    "brandingColor": {
      "type": [
        "null",
        "string"
      ]
    },
    "timeAdded": {
      "type": "string"
    },
    "fileSize": {
      "type": "integer"
    },
    "examPaperFlow": {
      "type": "string",
      "enum": [
        "Force Continuous",
        "Client Controlled",
        "Server Controlled"
      ]
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "questionsToAnswer": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "tags": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "mappedExaminees": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "examLink": {
      "type": "string"
    },
    "settings": {
      "$ref": "./Base Exam Settings Schema.json"
    }
  },
  "required": [
    "id",
    "examCode",
    "examTitle",
    "version",
    "brandingImage",
    "brandingColor",
    "timeAdded",
    "fileSize",
    "examPaperFlow",
    "papers",
    "questionsToAnswer",
    "tags",
    "mappedExaminees",
    "examLink"
  ]
}
